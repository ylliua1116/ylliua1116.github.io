'use client';

import { useId } from 'react';
import styles from './PaperMotionThumbnail.module.css';

/**
 * Four abstract, continuously animated research diagrams, keyed by V6.8 P1–P4.
 * These are original conceptual animations—not figures reproduced from papers.
 * No external assets or animation libraries are required.
 */
export default function PaperMotionThumbnail({ paperId }: { paperId: string }) {
  const prefix = useId().replace(/:/g, '');
  const gradId = `pm-bg-${prefix}`;
  const label = {
    P1: 'UAV and USV cooperative edge task offloading, with animated data flow',
    P2: 'Robotic line scanner and animated coverage path on a component',
    P3: 'Scene-graph prerequisites and retransmitted semantic packets over a wireless link',
    P4: 'Interference-aware causal network and online policy improvement',
  }[paperId] || 'Animated academic research concept';
  const ocean = paperId === 'P1';
  const robot = paperId === 'P2';
  const harq = paperId === 'P3';
  const causal = paperId === 'P4';

  return (
    <div className={styles.shell} title={label}>
      <svg className={styles.art} viewBox="0 0 280 200" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
        <defs>
          <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stopColor="#fcfaff" />
            <stop offset="54%" stopColor="#f3efff" />
            <stop offset="100%" stopColor={ocean ? '#d9f1fb' : robot ? '#e4edff' : harq ? '#e6f6f7' : '#e9e2ff'} />
          </linearGradient>
        </defs>
        <rect width="280" height="200" rx="17" fill={`url(#${gradId})`} />
        <g opacity=".28" fill="#ab96d8">
          {Array.from({ length: 9 }, (_, x) => Array.from({ length: 6 }, (_, y) => (
            <circle key={`${x}-${y}`} cx={14 + x * 31} cy={15 + y * 31} r=".8" />
          )))}
        </g>
        <rect x="9" y="10" width="262" height="180" rx="13" fill="none" stroke="#c6b5f2" strokeOpacity=".48" />

        {ocean && <>
          <text x="18" y="30" className={styles.header} fontSize={10.5} fontWeight={700} fontFamily="Arial, sans-serif" letterSpacing={0.35} fill="#55448e">UAV–USV / EDGE OFFLOADING</text>
          <rect x="220" y="16" rx="7" width="40" height="19" fill="#d7eeef" />
          <text x="240" y="29" textAnchor="middle" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">AIoTC</text>
          <g className={styles.float}><path d="M49 69h46" stroke="#5741ae" strokeWidth="3.3" strokeLinecap="round"/>
            <path d="M38 59h21m27 0h21M42 56l-6 6m17-6l6 6m31-6l-6 6m17-6l6 6" stroke="#7562bf" strokeWidth="2" strokeLinecap="round" />
            <rect x="59" y="62" width="26" height="15" rx="5" fill="#6855c1" />
            <path d="M69 77l-4 6m14-6 4 6" stroke="#6855c1" strokeWidth="2" />
          </g>
          <text x="65" y="96" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">UAV</text>
          <g opacity=".95">
            <path d="M0 140q25-7 52 0t55 0t58 0t55 0t60 0v60H0Z" fill="#d9effa" />
            <path className={styles.water} d="M-5 148q23-9 47 0t48 0t48 0t48 0t48 0t48 0" fill="none" stroke="#71b9d6" strokeWidth="2" />
            <path className={styles.waterSlow} d="M-9 163q26-6 52 0t52 0t52 0t52 0t52 0t52 0" fill="none" stroke="#a0d4e6" strokeWidth="2" />
          </g>
          <g className={styles.floatSlow}>
            <path d="M100 125h70l-13 22h-44Z" fill="#3c668a" />
            <rect x="125" y="111" width="25" height="15" rx="3" fill="#608aae" />
            <path d="M137 111v-13" stroke="#608aae" strokeWidth="2" />
          </g>
          <text x="116" y="168" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">USV</text>
          <g><rect x="218" y="69" width="43" height="61" rx="8" fill="#e8e2ff" stroke="#8069c3" strokeWidth="1.5"/>
            <rect x="225" y="78" width="29" height="12" rx="3" fill="#9c8ad5"/>
            <rect x="225" y="95" width="29" height="12" rx="3" fill="#b7abe5"/>
            <circle cx="245" cy="118" r="3" fill="#64beb6" className={styles.beat}/>
            <text x="240" y="145" textAnchor="middle" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">EDGE</text></g>
          <path d="M94 77Q137 79 139 111" fill="none" stroke="#6a59c3" strokeWidth="2" strokeDasharray="5 6" className={styles.dash}/>
          <path d="M169 129Q195 111 216 105" fill="none" stroke="#3caba8" strokeWidth="2.4" strokeDasharray="5 6" className={styles.dashFast}/>
          <circle cx="99" cy="81" r="5" fill="#a58cff" className={styles.travelUav}/>
          <circle cx="168" cy="129" r="5" fill="#31aeaa" className={styles.travelEdge}/>
          <text x="20" y="185" className={styles.footer} fontSize={7.8} fontWeight={700} fontFamily="Arial, sans-serif" letterSpacing={0.4} fill="#8475ad">TASKS · WIRELESS LINKS · EDGE RESOURCES</text>
        </>}

        {robot && <>
          <text x="18" y="30" className={styles.header} fontSize={10.5} fontWeight={700} fontFamily="Arial, sans-serif" letterSpacing={0.35} fill="#55448e">ROBOTIC LINE-SCAN PLANNING</text>
          <rect x="216" y="16" width="45" height="19" rx="7" fill="#e8e3ff" />
          <text x="238" y="29" textAnchor="middle" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">IEEE TIM</text>
          <rect x="143" y="120" width="110" height="58" rx="6" fill="#e6edff" stroke="#9da5db" strokeWidth="1.5"/>
          {Array.from({length:5},(_,i)=><path key={i} d={`M153 ${132+i*9}h91`} stroke="#b4bfe9" strokeDasharray="3 4" strokeWidth="1.2"/>)}
          <path d="M157 134H239V165H158V144H236V154H158" fill="none" stroke="#8570c9" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" strokeDasharray="280" strokeDashoffset="280" className={styles.trace}/>
          <circle cx="202" cy="152" r="4.2" fill="#ec819b" className={styles.beat}/>
          <path d="M24 172h56" stroke="#7460b4" strokeWidth="5" strokeLinecap="round"/>
          <rect x="27" y="153" width="29" height="20" rx="4" fill="#7e69ba" />
          <path d="M42 152L69 104L108 86L141 115" fill="none" stroke="#d4cafa" strokeWidth="14" strokeLinecap="round" strokeLinejoin="round"/>
          <path d="M42 152L69 104L108 86L141 115" fill="none" stroke="#6d58b4" strokeWidth="7" strokeLinecap="round" strokeLinejoin="round"/>
          <circle cx="69" cy="104" r="9" fill="#f2ecff" stroke="#785ec0" strokeWidth="4" />
          <circle cx="108" cy="86" r="9" fill="#f2ecff" stroke="#785ec0" strokeWidth="4" />
          <rect x="133" y="112" width="20" height="13" rx="4" fill="#5544a1"/>
          <g className={styles.scanner}><path d="M142 125L142 170" stroke="#f38cbd" strokeWidth="3" opacity=".75"/>
            <path d="M133 161L142 175L151 161" fill="#f38cbd" opacity=".12"/></g>
          <g className={styles.scanLine}><rect x="152" y="123" width="5" height="50" rx="2" fill="#b85acc" opacity=".72"/>
            <rect x="147" y="123" width="16" height="50" fill="#bb8df5" opacity=".10"/></g>
          <text x="21" y="57" className={styles.small} fontSize={9} fontWeight={700} fontFamily="Arial, sans-serif" fill="#7c68b0">PSO PATH</text>
          <path d="M24 62h47" stroke="#9c86d2" strokeWidth="1.5" />
          <text x="20" y="185" className={styles.footer} fontSize={7.8} fontWeight={700} fontFamily="Arial, sans-serif" letterSpacing={0.4} fill="#8475ad">COVERAGE · VIEWPOINTS · SURFACE DEFECTS</text>
        </>}

        {harq && <>
          <text x="18" y="30" className={styles.header} fontSize={10.5} fontWeight={700} fontFamily="Arial, sans-serif" letterSpacing={0.35} fill="#55448e">SEMANTIC PACKETS / HARQ</text>
          <rect x="219" y="16" width="42" height="19" rx="7" fill="#d6f5f1" />
          <text x="240" y="29" textAnchor="middle" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">IEEE TWC</text>
          <text x="22" y="58" className={styles.small} fontSize={9} fontWeight={700} fontFamily="Arial, sans-serif" fill="#7c68b0">SCENE GRAPH</text>
          <g stroke="#a08fda" strokeWidth="1.8" strokeDasharray="3 3" fill="none">
            <path d="M58 87L110 113L58 143" />
            <path d="M58 87L58 143" />
          </g>
          <g>
            <circle cx="58" cy="87" r="14" fill="#ece6ff" stroke="#8470cf" strokeWidth="2"/>
            <circle cx="110" cy="113" r="14" fill="#efe7ff" stroke="#8470cf" strokeWidth="2"/>
            <circle cx="58" cy="143" r="14" fill="#dbf3f1" stroke="#59ada8" strokeWidth="2"/>
            <text x="58" y="90" textAnchor="middle" className={styles.nodeText} fontSize={10} fontWeight={800} fontFamily="Arial, sans-serif" fill="#544394">O</text>
            <text x="110" y="116" textAnchor="middle" className={styles.nodeText} fontSize={10} fontWeight={800} fontFamily="Arial, sans-serif" fill="#544394">R</text>
            <text x="58" y="146" textAnchor="middle" className={styles.nodeText} fontSize={10} fontWeight={800} fontFamily="Arial, sans-serif" fill="#544394">T</text>
          </g>
          <path d="M127 112H199" stroke="#6e5ac6" strokeWidth="2.6" strokeDasharray="6 6" className={styles.dashFast}/>
          <path d="M181 103l11 9-11 9" stroke="#6e5ac6" strokeWidth="2.5" fill="none" />
          <g>
            <rect x="205" y="79" width="50" height="67" rx="10" fill="#e2f5f3" stroke="#62b6b1" strokeWidth="1.8" />
            <path d="M222 108l10 9 11-18" fill="none" stroke="#45a69b" strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round" />
            <text x="230" y="131" textAnchor="middle" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">RECEIVER</text>
          </g>
          <g className={styles.packetA}><rect x="125" y="103" width="16" height="17" rx="4" fill="#8e73db"/><path d="M130 109h6m-6 4h6" stroke="#fff" strokeWidth="1.3" /></g>
          <g className={styles.packetB}><rect x="125" y="103" width="16" height="17" rx="4" fill="#46b5b2"/><path d="M130 109h6m-6 4h6" stroke="#fff" strokeWidth="1.3" /></g>
          <path d="M225 77Q183 47 148 80" fill="none" stroke="#ee9aaf" strokeWidth="2" strokeDasharray="4 5" className={styles.dash}/>
          <text x="159" y="63" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">RETRY</text>
          <circle className={styles.retryDot} cx="223" cy="78" r="4.5" fill="#ee9aaf" />
          <text x="20" y="185" className={styles.footer} fontSize={7.8} fontWeight={700} fontFamily="Arial, sans-serif" letterSpacing={0.4} fill="#8475ad">PREREQUISITES · LINK ADAPTATION · RETRIES</text>
        </>}

        {causal && <>
          <text x="18" y="30" className={styles.header} fontSize={10.5} fontWeight={700} fontFamily="Arial, sans-serif" letterSpacing={0.35} fill="#55448e">CAUSAL NETWORK CONFIG.</text>
          <rect x="224" y="16" width="37" height="19" rx="7" fill="#eee5ff" />
          <text x="243" y="29" textAnchor="middle" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">NeurIPS</text>
          <text x="22" y="58" className={styles.small} fontSize={9} fontWeight={700} fontFamily="Arial, sans-serif" fill="#7c68b0">INTERFERENCE NETWORK</text>
          <g stroke="#a08ccf" strokeWidth="1.7" fill="none" strokeDasharray="4 5" className={styles.dash}>
            <path d="M43 84L94 75L139 101L95 145L44 133Z" />
            <path d="M43 84L95 145M94 75L44 133M94 75L95 145M139 101L44 133" />
          </g>
          <g>
            <circle cx="43" cy="84" r="10" fill="#ece6ff" stroke="#8269c8" strokeWidth="2.5" className={styles.beat} />
            <circle cx="94" cy="75" r="10" fill="#efeaff" stroke="#8269c8" strokeWidth="2.5" />
            <circle cx="139" cy="101" r="10" fill="#ded5fa" stroke="#8269c8" strokeWidth="2.5" className={styles.beatOffset}/>
            <circle cx="95" cy="145" r="10" fill="#efeaff" stroke="#8269c8" strokeWidth="2.5" />
            <circle cx="44" cy="133" r="10" fill="#d9f2ef" stroke="#51aaa5" strokeWidth="2.5" className={styles.beatDelay}/>
          </g>
          <path d="M152 112h21" stroke="#8370c9" strokeWidth="2.5" strokeDasharray="3 5" className={styles.dashFast}/>
          <path d="M170 106l7 6-7 6" stroke="#8370c9" strokeWidth="2.5" fill="none" />
          <g>
            <rect x="181" y="69" width="81" height="96" rx="10" fill="#f4f0ff" stroke="#b3a4e3" strokeWidth="1.5" />
            <text x="190" y="84" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">STEADY STATE</text>
            <path d="M192 145H251M192 145V97" stroke="#b5a7de" strokeWidth="1.7" fill="none" />
            <path d="M193 138L204 130L214 132L225 114L236 109L248 99" fill="none" stroke="#6e54bb" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" className={styles.learningCurve} />
            <circle className={styles.beat} cx="248" cy="99" r="4" fill="#42aaa4" />
            <text x="195" y="157" className={styles.micro} fontSize={8} fontWeight={700} fontFamily="Arial, sans-serif" fill="#6b5e9c">online policy</text>
          </g>
          <text x="20" y="185" className={styles.footer} fontSize={7.8} fontWeight={700} fontFamily="Arial, sans-serif" letterSpacing={0.4} fill="#8475ad">EXPOSURE · DOUBLY ROBUST · FEEDBACK</text>
        </>}
      </svg>
      <span className={styles.srOnly}>Conceptual animation, not the original figure from the paper.</span>
    </div>
  );
}
