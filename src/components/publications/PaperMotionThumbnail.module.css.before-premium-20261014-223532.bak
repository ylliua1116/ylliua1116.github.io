.shell {
  width: 100%;
  height: 100%;
  min-width: 0;
  position: relative;
  overflow: hidden;
  isolation: isolate;
  background: #f5f0ff;
  transition: filter .25s ease;
}
.shell:hover { filter: saturate(1.2) contrast(1.04); }
.art { display: block; height: 100%; width: 100%; }
.header { font: 700 12px system-ui, -apple-system, sans-serif; letter-spacing: .65px; fill: #55448e; }
.small { font: 700 9px system-ui, -apple-system, sans-serif; letter-spacing: .3px; fill: #7c68b0; }
.micro { font: 700 8px system-ui, -apple-system, sans-serif; fill: #6b5e9c; letter-spacing: .3px; }
.nodeText { font: 800 10px system-ui, -apple-system, sans-serif; fill: #544394; }
.footer { font: 700 7.8px system-ui, -apple-system, sans-serif; letter-spacing: .5px; fill: #8475ad; }
.srOnly { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

.dash { animation: dash 4.5s linear infinite; }
.dashFast { animation: dash 2.4s linear infinite; }
.water { animation: waterShift 6s ease-in-out infinite alternate; }
.waterSlow { animation: waterShift 8s ease-in-out infinite alternate-reverse; }
.float { animation: bob 3.2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
.floatSlow { animation: bob 4.4s ease-in-out infinite reverse; transform-box: fill-box; transform-origin: center; }
.beat { animation: pulse 2.3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
.beatOffset { animation: pulse 2.3s ease-in-out -.8s infinite; transform-box: fill-box; transform-origin: center; }
.beatDelay { animation: pulse 2.3s ease-in-out -1.5s infinite; transform-box: fill-box; transform-origin: center; }
.travelUav { animation: travelUav 3.5s ease-in-out infinite; }
.travelEdge { animation: travelEdge 2.8s ease-in-out -.4s infinite; }
.trace { animation: drawTrace 7s ease-in-out infinite; }
.scanLine { animation: scannerSweep 4.5s ease-in-out infinite; }
.scanner { animation: subtleScan 3.5s ease-in-out infinite; }
.packetA { animation: packetTravel 4s linear infinite; }
.packetB { animation: packetTravel 4s linear -2s infinite; }
.retryDot { animation: retryMove 4s ease-in-out infinite; }
.learningCurve { stroke-dasharray: 105; stroke-dashoffset: 105; animation: growCurve 6s ease-in-out infinite; }

@keyframes dash { to { stroke-dashoffset: -44; } }
@keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
@keyframes pulse { 0%,100% { opacity: .75; transform: scale(1); } 50% { opacity: 1; transform: scale(1.22); } }
@keyframes waterShift { from { transform: translateX(-7px); } to { transform: translateX(7px); } }
@keyframes travelUav { 0%,12% { transform: translate(0,0); opacity:0;} 20% {opacity:1;} 80% {opacity:1;} 90%,100% {transform:translate(39px,39px);opacity:0;} }
@keyframes travelEdge { 0%,12% { transform: translate(0,0); opacity:0;} 25% {opacity:1;} 85% {opacity:1;} 100% {transform:translate(47px,-24px);opacity:0;} }
@keyframes drawTrace { 0%,9% { stroke-dashoffset:280;} 64%,84% { stroke-dashoffset:0;} 100% { stroke-dashoffset:280;} }
@keyframes scannerSweep { 0%,7%,100% { transform:translateX(0); opacity:.15; } 16% {opacity:.85;} 62% {transform:translateX(86px);opacity: .85;} 76% {transform:translateX(86px);opacity:.1;} }
@keyframes subtleScan { 0%,100% { opacity:.35; } 50% { opacity:.9; } }
@keyframes packetTravel { 0%,14% { transform:translateX(0);opacity:0;} 20% {opacity:1;} 78% {opacity:1;} 93%,100% {transform:translateX(68px);opacity:0;} }
@keyframes retryMove { 0%,34%,100% {opacity:0;transform:translate(0,0);} 42% {opacity:1;} 78% {opacity:1;} 96% {opacity:0;transform:translate(-75px,-2px);} }
@keyframes growCurve { 0%,10% {stroke-dashoffset:105;} 62%,85% {stroke-dashoffset:0;} 100% {stroke-dashoffset:105;} }

/* Accessibility: all important objects remain visible as a static diagram. */
@media (prefers-reduced-motion: reduce) {
 .shell *, .shell { animation: none !important; transition: none !important; }
 .trace, .learningCurve { stroke-dashoffset: 0 !important; }
 .packetB, .retryDot { opacity: 0 !important; }
}
